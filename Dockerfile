# syntax=docker/dockerfile:1
# datasteg trade-flow: Next.js standalone server, built from this folder (trade-flow.datasteg.com).
#
# The build stage runs on the machine's own platform (BUILDPLATFORM), so Next.js compiles at native speed; its output
# is plain JavaScript, which the runtime stage (TARGETPLATFORM, linux/amd64 for the server) copies as is.
# data/ (generated by the Python builders, gitignored) must be in the build context: it is copied into the image and
# served from /app/data. The image holds nothing private.

FROM --platform=$BUILDPLATFORM node:24.22.0-alpine AS build
WORKDIR /repo
RUN npm install -g pnpm@11.18.0 >/dev/null
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch
COPY . .
RUN pnpm install --offline --frozen-lockfile
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION NEXT_TELEMETRY_DISABLED=1
RUN BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) pnpm build

FROM node:24.22.0-alpine
WORKDIR /app
ARG APP_VERSION=dev
ENV NODE_ENV=production PORT=8080 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1 APP_VERSION=$APP_VERSION
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
# The generated data folder (*.json.br, *.json.gz), read by app/data/[...path] and lib/data.ts.
COPY data ./data
ENV DATA_DIR=/app/data
# Any non-root UID works. wget (busybox) serves the healthcheck.
USER 10070:10070
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
